<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DemoBlaze E2E Suite" verbose="1" thread-count="1" parallel="none">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.example.demoblaze.listeners.TestListener"/>
    </listeners>

    <test name="E2E Purchase Flow">
        <groups>
            <run>
                <include name="e2e"/>
            </run>
        </groups>
        <packages>
            <package name="com.example.demoblaze.tests.e2e"/>
        </packages>
    </test>

</suite>
